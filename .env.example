# --- Pick your AI: "doubao" (default), "anthropic", or "openai" ---
AI_PROVIDER=doubao

# --- Doubao (ByteDance) via Volcengine ---
# Get a key: https://console.volcengine.com → activate the Doubao model → Ark → API key management
DOUBAO_API_KEY=
# Model ID, e.g. doubao-seed-1-6-250615 (or doubao-seed-1-6-flash-250615 = faster + cheaper)
DOUBAO_MODEL=doubao-seed-1-6-250615

# --- (backup providers) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Business: free readings per visitor per day (then paywall) ---
FREE_READINGS_PER_DAY=3
# Members get more:
FREE_READINGS_PER_DAY_MEMBER=5
# --- Charging is OFF by default (free for everyone). ---
# Set to "true" when you're ready to charge visitors.
PAYMENTS_ENABLED=false
# --- Price: one-time payment in CNY, and how many readings it buys ---
PRICE_CNY=9.9
READINGS_PER_PACK=10

# --- XorPay (WeChat Pay / Alipay for individuals) — from https://xorpay.com ---
# Sign up → fill in your info → wait for review → scan to sign the agreement → find aid + secret in the dashboard
XORPAY_AID=
XORPAY_SECRET=

# Your public site URL (no trailing slash), e.g. https://moontarot.tech
# XorPay calls BASE_URL + /api/xorpay-notify after payment, so this must be public HTTPS.
BASE_URL=http://localhost:3000

# --- Email verification (QQ Mail SMTP, free) ---
# Registration requires email verification. In QQ Mail web: Settings → Accounts →
# enable SMTP service → generate an authorization code.
# (SMTP_PASS takes the authorization code, NOT your QQ password!)
# The site runs without these two keys: codes go to the server console in dev
# mode (handy for testing), but configure them before launch.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender display name, defaults to "Moonlit <SMTP_USER>"
# SMTP_FROM=Moonlit <you@qq.com>

# --- User database + admin dashboard ---
# Password for /admin.html (your private stats page). Pick something only you know.
ADMIN_TOKEN=choose-a-secret-password-here
